{
  "name": "CareerOS",
  "version": "0.1.0",
  "private": true,
  "description": "CareerOS — AI-powered career operating system",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter @career-os/* run build",
    "dev:frontend": "pnpm --filter @career-os/web dev",
    "dev:backend": "cd backend && .venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 4000",
    "dev": "concurrently \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:extension": "pnpm --filter @career-os/extension dev",
    "lint": "eslint --no-error-on-unmatched-pattern \"frontend/**/*.{js,mjs,cjs,ts,tsx}\" \"extension/**/*.{js,mjs,cjs,ts,tsx}\" \"packages/**/*.{js,mjs,cjs,ts,tsx}\" \"scripts/**/*.{js,mjs,cjs}\" \"tools/**/*.{js,mjs,cjs,ts,tsx}\"",
    "lint:strict": "pnpm lint -- --max-warnings 0",
    "lint:python": "cd backend && python -m ruff check . --exclude .venv",
    "lint:python:advisory": "cd backend && python -m ruff check . --exclude .venv --exit-zero",
    "typecheck:python": "cd backend && python -m mypy .",
    "typecheck:python:advisory": "cd backend && (python -m mypy . || echo Python typing is advisory during staged adoption)",
    "typecheck": "pnpm -r --filter @career-os/* run typecheck",
    "test": "pnpm -r --filter @career-os/* run test",
    "test:backend": "cd backend && python -m pytest tests -q",
    "test:frontend": "pnpm --filter @career-os/web test:e2e",
    "test:a11y": "pnpm --filter @career-os/web test:e2e --grep @a11y",
    "quality:advisory": "pnpm lint && pnpm lint:python:advisory && pnpm typecheck:python:advisory",
    "ci": "node scripts/ci-run.mjs",
    "ci:typecheck": "pnpm --filter @career-os/core build && pnpm typecheck",
    "ci:extension-unit": "pnpm --filter @career-os/extension test",
    "repair:dev": "python tools/repair-orchestrator/run_dev.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.17.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  }
}
