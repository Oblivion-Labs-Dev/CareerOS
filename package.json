{
  "name": "CareerOS",
  "version": "0.1.0",
  "private": true,
  "description": "CareerOS — AI-powered career operating system",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter @career-os/* run build",
    "dev:web": "pnpm --filter @career-os/web dev",
    "dev:api": "pnpm --filter @career-os/api dev",
    "dev": "pnpm --filter @career-os/api --filter @career-os/web --parallel run dev",
    "lint": "eslint --no-error-on-unmatched-pattern \"apps/**/*.{js,mjs,cjs,ts,tsx}\" \"packages/**/*.{js,mjs,cjs,ts,tsx}\" \"scripts/**/*.{js,mjs,cjs}\" \"tools/**/*.{js,mjs,cjs,ts,tsx}\"",
    "lint:strict": "pnpm lint -- --max-warnings 0",
    "lint:python": "cd apps/api && python -m ruff check app tests scripts",
    "lint:python:advisory": "cd apps/api && python -m ruff check app tests scripts --exit-zero",
    "typecheck:python": "cd apps/api && python -m mypy app",
    "typecheck:python:advisory": "cd apps/api && (python -m mypy app || echo Python typing is advisory during staged adoption)",
    "test:a11y": "pnpm --filter @career-os/web test:e2e --grep @a11y",
    "quality:advisory": "pnpm lint && pnpm lint:python:advisory && pnpm typecheck:python:advisory",
    "dev:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/restart-dev.ps1 -Background",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup.ps1",
    "setup:quick": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup.ps1 -SkipModels -SkipTests",
    "dev:extension": "pnpm --filter @career-os/extension dev",
    "typecheck": "pnpm -r --filter @career-os/* run typecheck",
    "test": "pnpm -r --filter @career-os/* run test",
    "test:api": "cd apps/api && python -m pytest tests -q",
    "test:web": "pnpm --filter @career-os/web test:e2e",
    "test:repair": "cd tools/repair-orchestrator && python -m pytest tests -q",
    "ci": "node scripts/ci-run.mjs",
    "ci:typecheck": "pnpm --filter @career-os/core build && pnpm typecheck",
    "ci:extension-unit": "pnpm --filter @career-os/extension test",
    "ci:api": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ci-api.ps1",
    "ci:web-e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ci-web-e2e.ps1",
    "prepare:hooks": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-git-hooks.ps1",
    "repair:up": "docker compose -f docker-compose.repair.yml up --build",
    "repair:down": "docker compose -f docker-compose.repair.yml down",
    "repair:dev": "python tools/repair-orchestrator/run_dev.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.17.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  }
}
