#!/bin/sh
# Fast local gate only — see .githooks/pre-commit for why (api pytest and
# web-e2e repeatedly OOM-killed this machine partway through; GitHub Actions
# still runs typecheck/extension-unit/api on push, so this isn't the only net
# for those — web-e2e is, and now only runs on demand via `pnpm ci`).
if [ "$SKIP_CI" = "1" ]; then
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1

echo "pre-push: running fast CI (typecheck, extension-unit)..."
echo "  Full suite (api, web-e2e): pnpm ci"
echo "  Skip entirely: SKIP_CI=1 git push ...  or  git push --no-verify"

pnpm --filter @career-os/core build \
  && pnpm typecheck \
  && pnpm --filter @career-os/extension test
