# CareerOS — copy to .env (setup.bat / scripts/setup.ps1 does this automatically)

# Web dashboard
NEXT_PUBLIC_API_URL=http://localhost:4000

# Local extension folder for Load unpacked (setup script writes your absolute path in apps/web/.env.local)
NEXT_PUBLIC_EXTENSION_DIST_PATH=

# One-click install (set after AMO / Chrome Web Store publish)
NEXT_PUBLIC_FIREFOX_ADDONS_URL=
NEXT_PUBLIC_CHROME_WEB_STORE_URL=
NEXT_PUBLIC_EDGE_ADDONS_URL=

# FastAPI backend
CAREER_OS_DATABASE_URL=sqlite:///./data/career_os.db
CAREER_OS_DEV_MODE=true
CAREER_OS_API_KEY=
# Bearer token for POST /api/jobs/import/batch (external job ingestion); empty disables it.
CAREEROS_IMPORT_API_TOKEN=
CAREER_OS_API_PUBLIC_URL=http://localhost:4000
CAREER_OS_FIREFOX_ADDONS_URL=
CAREER_OS_CHROME_WEB_STORE_URL=
CAREER_OS_EDGE_ADDONS_URL=
CAREER_OS_CORS_ORIGINS=http://localhost:5000,chrome-extension://*

# Optional cloud LLM (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Gmail SMTP/IMAP (see docs/email.md)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Chrome extension (build-time via apps/extension/.env)
CAREER_OS_API_URL=http://localhost:4000

# Application Assistant
# Parallel prep/review: up to 10 concurrent browser jobs locally (RAM-heavy — ~1GB per headed Chrome)
AA_MAX_CONCURRENT_PREP=10
AA_MAX_PREP_QUEUE=20
AA_PREP_TIMEOUT=600
APPLICATION_ASSISTANT_ENABLED=true

# Field mapping agent. Blank model = use the configured cloud model
# (Gemini when GEMINI_API_KEY is set), otherwise deterministic mapping only.
CHRONOS_MAPPING_ENABLED=true
CHRONOS_MAPPING_MODEL=
CHRONOS_MAPPING_CONFIDENCE=0.90
CHRONOS_REVIEW_CONFIDENCE=0.70
CHRONOS_VISION_ENABLED=false


# ── Free AI (optional) ──
# Gemini free tier, no card needed. Key at https://aistudio.google.com/apikey
# Leave blank and CareerOS still works: answers come from your saved profile only.
GEMINI_API_KEY=

# ── Your files (blank = the defaults described in README.md) ──
# Resume PDF Autopilot uploads (default: apps/api/data/resume.pdf)
CAREEROS_RESUME_PATH=
# Your resume match profile (default: the neutral one bundled with the app)
CAREEROS_MATCH_PROFILE=
# Queue ranking preferences JSON, e.g. {"preferred_locations": ["Austin", "TX"]}
CAREEROS_RANKING_PREFERENCES=

# ── Automation safety ──
# true (the default) lets Autopilot click the final Submit button on real
# employer sites. Set false to have it fill each form, stop before Submit and
# tell you so.
ALLOW_REAL_SUBMISSION=true
