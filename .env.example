# CareerOS — copy to .env (setup.bat / scripts/setup.ps1 does this automatically)

# Web dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local extension folder for Load unpacked (setup script writes your absolute path in apps/web/.env.local)
NEXT_PUBLIC_EXTENSION_DIST_PATH=

# One-click install (set after AMO / Chrome Web Store publish)
NEXT_PUBLIC_FIREFOX_ADDONS_URL=
NEXT_PUBLIC_CHROME_WEB_STORE_URL=
NEXT_PUBLIC_EDGE_ADDONS_URL=

# FastAPI backend
CAREER_OS_DATABASE_URL=sqlite:///./data/career_os.db
CAREER_OS_DEV_MODE=true
CAREER_OS_API_KEY=
CAREER_OS_API_PUBLIC_URL=http://localhost:8000
CAREER_OS_FIREFOX_ADDONS_URL=
CAREER_OS_CHROME_WEB_STORE_URL=
CAREER_OS_EDGE_ADDONS_URL=
CAREER_OS_CORS_ORIGINS=http://localhost:3000,chrome-extension://*

# Optional cloud LLM (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Gmail SMTP/IMAP (see docs/email.md)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Chrome extension (build-time via apps/extension/.env)
CAREER_OS_API_URL=http://localhost:8000

# Application Assistant — local Ollama (recommended for prep + question understanding)
# Parallel prep/review: up to 10 concurrent browser+LLM jobs locally (RAM-heavy — ~1GB per headed Chrome)
AA_MAX_CONCURRENT_PREP=10
AA_MAX_PREP_QUEUE=20
AA_PREP_TIMEOUT=600
APPLICATION_ASSISTANT_ENABLED=true
APPLICATION_ASSISTANT_LLM_BASE_URL=http://localhost:11434/v1
# Recommended: qwen3:8b (best balance). Faster: qwen3:4b or qwen2.5:7b-instruct. Smarter/slower: qwen3:14b
APPLICATION_ASSISTANT_LLM_MODEL=qwen3:8b
APPLICATION_ASSISTANT_LLM_API_KEY=

# Field mapping agent (uses same Ollama model by default)
CHRONOS_MAPPING_ENABLED=true
CHRONOS_MAPPING_MODEL=qwen3:8b
CHRONOS_MAPPING_CONFIDENCE=0.90
CHRONOS_REVIEW_CONFIDENCE=0.70
CHRONOS_VISION_ENABLED=false
