# CareerOS — copy to .env and adjust for local development

# Web dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local extension folder for Load unpacked (absolute path on your machine)
NEXT_PUBLIC_EXTENSION_DIST_PATH=D:\1 - Projects\Projects\CareerOS\CareerOS\apps\extension\dist

# One-click install (set after AMO / Chrome Web Store publish)
# Firefox (free on AMO): https://addons.mozilla.org/firefox/addon/careeros-applypilot/
NEXT_PUBLIC_FIREFOX_ADDONS_URL=

# FastAPI backend
CAREER_OS_DATABASE_URL=sqlite:///./data/career_os.db
CAREER_OS_DEV_MODE=true
CAREER_OS_API_KEY=
CAREER_OS_API_PUBLIC_URL=http://localhost:8000
CAREER_OS_FIREFOX_ADDONS_URL=
CAREER_OS_CHROME_WEB_STORE_URL=
CAREER_OS_EDGE_ADDONS_URL=
# Chrome: https://chromewebstore.google.com/detail/your-extension-id
NEXT_PUBLIC_CHROME_WEB_STORE_URL=
NEXT_PUBLIC_EDGE_ADDONS_URL=
CAREER_OS_CORS_ORIGINS=http://localhost:3000,chrome-extension://*
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Gmail SMTP/IMAP (see docs/email.md)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Chrome extension (build-time via apps/extension/.env)
CAREER_OS_API_URL=http://localhost:8000
