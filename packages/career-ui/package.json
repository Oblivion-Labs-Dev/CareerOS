{
  "name": "@career-os/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./corpus": {
      "types": "./dist/corpus/index.d.ts",
      "import": "./dist/corpus/index.js",
      "default": "./dist/corpus/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "framer-motion": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-intersection-observer": "^9.0.0"
  },
  "dependencies": {
    "@arsenal/ui": "workspace:*",
    "@career-os/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "react": "^19.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2"
  }
}
