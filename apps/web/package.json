{
  "name": "@career-os/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000 --turbopack",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev --port 3000 --turbopack",
    "dev:webpack": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@career-os/core": "workspace:*",
    "@career-os/ui": "workspace:*",
    "next": "^15.1.0",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.7.15",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-intersection-observer": "^9.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^20.17.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.7.2"
  }
}
