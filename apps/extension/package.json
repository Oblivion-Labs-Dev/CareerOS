{
  "name": "@career-os/extension",
  "version": "0.2.0",
  "description": "ApplyPilot — MV3 extension for Chrome and Firefox job application autofill",
  "type": "module",
  "scripts": {
    "build": "tsup && node scripts/copy-assets.js && node scripts/verify-dist.mjs",
    "build:firefox": "python scripts/generate-icons.py && tsup && node scripts/copy-assets.js && node scripts/patch-firefox-dist.mjs && node scripts/verify-dist.mjs && node scripts/verify-firefox.mjs && node scripts/package-firefox.mjs",
    "lint:firefox": "web-ext lint --source-dir dist",
    "publish:firefox": "node scripts/publish-firefox.mjs",
    "run:firefox": "node scripts/run-firefox-dev.mjs",
    "dev": "tsup --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify:browser": "node scripts/browser-verify.mjs"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/chrome": "^0.0.306",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "pdf-parse": "^2.4.5",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9",
    "web-ext": "^8.3.0"
  }
}
