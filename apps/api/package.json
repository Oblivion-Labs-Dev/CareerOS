{
  "name": "@career-os/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "python -m uvicorn app.main:app --reload --reload-dir app --host 127.0.0.1 --port 4000",
    "dev:reload": "python -m uvicorn app.main:app --reload --reload-dir app --host 127.0.0.1 --port 4000",
    "start": "python -m uvicorn app.main:app --host 127.0.0.1 --port 4000",
    "typecheck": "python -m compileall app",
    "email:send": "python scripts/email/send_email.py",
    "email:threads": "python scripts/email/fetch_recruiter_threads.py",
    "email:sync": "python scripts/email/sync_recruiter_conversations.py"
  }
}
