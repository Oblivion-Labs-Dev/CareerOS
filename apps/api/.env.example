# CareerOS Database — SQLite default for local dev; PostgreSQL for production
# Local: sqlite:///./data/career_os.db
# Cloud: postgresql://user:password@host:5432/career_os
CAREER_OS_DATABASE_URL=sqlite:///./data/career_os.db
CAREER_OS_DEV_MODE=true
CAREER_OS_API_KEY=

# Multi-tenant Auth & Cloud Storage (Option A: Supabase / PostgreSQL)
CAREEROS_MULTITENANT_MODE=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Bearer token for POST /api/jobs/import/batch (external job ingestion); empty disables it.
CAREEROS_IMPORT_API_TOKEN=
CAREER_OS_API_PUBLIC_URL=http://localhost:8000
CAREER_OS_CORS_ORIGINS=http://localhost:3000,chrome-extension://*
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Apify — free plan $5/month prepaid credits, no card. Token at:
#   https://console.apify.com/settings/integrations (APIFY_TOKEN also enables
#   the LinkedIn/Indeed actors used by scrape mode "apify")
APIFY_TOKEN=

# ── Job-discovery sources: all have $0 free tiers; adapters stay inert until keys are set ──
# SerpApi (Google Jobs) — 100 successful searches/month free, no card. Key at:
#   https://serpapi.com/manage-api-key  (guards already default to the free
#   allowance; raise SERPAPI_MONTHLY_QUOTA only for a paid plan)
SERPAPI_KEY=
# SERPAPI_MONTHLY_QUOTA=100
# SERPAPI_DAILY_BUDGET=3

# Google Programmable Search — 100 queries/day free. Needs BOTH of:
#   API key:    https://console.cloud.google.com/apis/credentials
#               (enable the "Custom Search API" on the project)
#   Engine id:  https://programmablesearchengine.google.com/control_panel/all
#               ("Search the entire web" + programmatic access enabled)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=
# GOOGLE_CSE_DAILY_BUDGET=90

# Fantastic.jobs — Free plan ~500 job credits/mo + ~50 API requests/wk (sign up on the
#   FREE plan at developer.fantastic.jobs; the 7-day trial needs no card and the free
#   tier avoids the $95/mo Pro plan). Guards default to the free allowance; rows are
#   requested US-wide and trimmed locally by the shared US filter.
FANTASTIC_JOBS_API_KEY=
# FANTASTIC_JOBS_MONTHLY_JOBS=500
# FANTASTIC_JOBS_WEEKLY_REQUESTS=45

# TheirStack — one-time signup credits (~1,000-1,500; 1 credit = 1 job returned),
#   not recurring. Key at https://app.theirstack.com/settings/api-key. The adapter
#   spends at most THEIRSTACK_TOTAL_CREDITS lifetime (default 900) then stops itself.
THEIRSTACK_API_KEY=
# THEIRSTACK_TOTAL_CREDITS=900
# THEIRSTACK_JOB_LIMIT=50

# Application Assistant — local Ollama (see setup.bat)
AA_MAX_CONCURRENT_PREP=10
AA_MAX_PREP_QUEUE=20
AA_PREP_TIMEOUT=600
APPLICATION_ASSISTANT_ENABLED=true
APPLICATION_ASSISTANT_LLM_BASE_URL=http://localhost:11434/v1
# qwen3:8b recommended; qwen3:4b faster; qwen3:14b smarter/slower
APPLICATION_ASSISTANT_LLM_MODEL=qwen3:8b
CHRONOS_MAPPING_ENABLED=true
CHRONOS_MAPPING_MODEL=qwen3:8b

# Gmail SMTP/IMAP (recruiter outreach — see docs/email.md)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Automated repair pipeline (manual POC — disabled by default)
CAREER_OS_REPAIR_DEMO_ENABLED=false
CAREER_OS_REPAIR_AGENT_ADAPTER=mock
