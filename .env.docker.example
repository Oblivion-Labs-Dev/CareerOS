# Optional overrides for `docker compose up`.
#
# Copy to `.env` in the repository root if you need to change anything —
# Compose reads that file automatically for ${...} substitution in
# docker-compose.yml. Every value below already has a working default, so an
# empty file (or no file at all) is the normal case.
#
# This file is an example and is safe to commit. The real `.env` is gitignored
# and is never copied into an image (see .dockerignore).

# ── Database ─────────────────────────────────────────────────────────────────
# CareerOS uses SQLite, not MySQL. The container opens the same file the local
# workflow does, through the bind mount defined in docker-compose.yml. There is
# no database container and nothing is migrated.
#
# Point this at a scratch directory to leave the real database alone — the safe
# way to experiment with Docker without touching ~1,000 real applications:
#   CAREEROS_DATA_DIR=./apps/api/.docker-data
CAREEROS_DATA_DIR=./apps/api/data
CAREER_OS_DATABASE_URL=sqlite:///./data/career_os.db

# ── Host Ollama ──────────────────────────────────────────────────────────────
# Ollama stays on the host; models are never duplicated into a container.
# host.docker.internal resolves to the host from inside the container.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
APPLICATION_ASSISTANT_LLM_BASE_URL=http://host.docker.internal:11434/v1
# Used only by the liveness probes in main.py, diagnostic.py and
# observability.py. Note there is no /v1 suffix here — these call /api/tags.
CAREEROS_OLLAMA_HEALTH_URL=http://host.docker.internal:11434

# ── Web → API ────────────────────────────────────────────────────────────────
# Read by apps/web/app/api/backend/[...path]/route.ts. Inside the compose
# network the API answers to its service name.
CAREER_OS_API_PUBLIC_URL=http://api:4000

# ── Browser ──────────────────────────────────────────────────────────────────
# A container has no display, so headed Chromium cannot run there. This matches
# the existing default in autopilot_runner.py.
AA_HEADLESS=true
